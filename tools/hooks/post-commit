#!/usr/bin/env bash
# Shows the performance status table after each commit.
# Tests run (and gate) in pre-commit; this is informational only.
#
# Install: bash platform/deploy/scripts/install-hooks.sh
# Skip once: SUN_SKIP_HOOKS=1 git commit ...

[ "${SUN_SKIP_HOOKS:-0}" = "1" ] && exit 0

REPO_ROOT="$(git rev-parse --show-toplevel)"
PERF="$REPO_ROOT/platform/deploy/scripts/perf.sh"

[ -x "$PERF" ] || exit 0

echo ""
bash "$PERF" status
