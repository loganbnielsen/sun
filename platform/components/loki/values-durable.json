{
  "deploymentMode": "Monolithic",
  "singleBinary": {
    "replicas": 1
  },
  "write": { "replicas": 0 },
  "read": { "replicas": 0 },
  "backend": { "replicas": 0 },
  "loki": {
    "commonConfig": { "replication_factor": 1 },
    "storage": { "type": "s3" },
