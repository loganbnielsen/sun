# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Sun — opinionated OCaml 5 production platform for startups"
depends: [
  "ocaml" {>= "5.4.0"}
  "dune" {>= "3.0" & >= "3.0"}
  "eio"
  "eio_main"
  "cohttp-eio"
  "yojson"
  "cmdliner"
  "base64"
  "uri"
  "cstruct"
  "tls-eio"
  "x509"
  "domain-name"
  "ptime"
  "mtime"
  "caqti-eio"
  "caqti-driver-postgresql"
  "otoml"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
